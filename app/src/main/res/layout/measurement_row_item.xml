<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:padding="12dp"
    android:background="@drawable/circuit_row_background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/scrollHandle"
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮⋮"
            android:textSize="22sp"
            android:textColor="#999999"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/applianceContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <Spinner
                android:id="@+id/applianceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:visibility="visible"/>

            <LinearLayout
                android:id="@+id/customApplianceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/customApplianceEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Inne urządzenie..."
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:background="@drawable/input"
                    android:padding="12dp" />

                <TextView
                    android:id="@+id/flatNumberTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lokal"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/customApplianceSaveBtn"
                    android:text="✔"
                    android:minWidth="0dp"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="0dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Zapisz urządzenie" />

                <Button
                    android:id="@+id/customApplianceClearBtn"
                    android:text="X"
                    android:minWidth="0dp"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="0dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    android:contentDescription="Anuluj" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/switchContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/switchEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="wyłącznik"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/switchSaveBtn"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_gravity="center_horizontal"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="Zapisz wyłącznik" />
        </LinearLayout>

        <Spinner
            android:id="@+id/breakerSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/ampsSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ohmsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/ohmsEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ω"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/ohmsSaveBtn"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Zapisz rezystancję" />
        </LinearLayout>

        <Spinner
            android:id="@+id/noteSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            tools:visibility="visible"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:id="@+id/customNoteContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/customNoteEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Inne..."
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/customNoteSaveBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:visibility="gone"
                android:contentDescription="Zapisz uwagę" />

            <Button
                android:id="@+id/customNoteClearBtn"
                android:text="X"
                android:minWidth="0dp"
                android:minHeight="0dp"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="Anuluj uwagę" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🗑️"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"
            android:minWidth="0dp"
            android:layout_marginEnd="10dp"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_gravity="center_horizontal"
            android:minHeight="0dp"
            android:contentDescription="Usuń pomiar" />

        <Button
            android:id="@+id/photoBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="📷"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#8C8C8C"
            android:minWidth="0dp"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_gravity="center_horizontal"
            android:minHeight="0dp"
            android:contentDescription="Zrób zdjęcie" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:id="@+id/rcdHeaders"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <Space android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView
            style="@style/MeasurementHeader"
            android:layout_weight="1.5"
            android:text="Status" />
        <TextView
            style="@style/MeasurementHeader"
            android:layout_weight="2"
            android:text="Producent" />
        <TextView
            style="@style/MeasurementHeader"
            android:layout_weight="1"
            android:text="Czas [Ms]" />
        <TextView
            style="@style/MeasurementHeader"
            android:layout_weight="1"
            android:text="Prąd [mA]" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/rcdRowContainer"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <Space android:layout_width="38dp" android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/rcdStateSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:id="@+id/rcdNameContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/rcdNameEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nazwa różnicówki"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/rcdNameSaveBtn"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_gravity="center_horizontal"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="Zapisz producenta RCD" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rcdTimeContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/rcdTimeEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Czas (ms)"
                android:inputType="number"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/rcdTimeSaveBtn"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_gravity="center_horizontal"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="Zapisz czas RCD" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rcdCurrentContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/rcdCurrentEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Prąd (mA)"
                android:inputType="number"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:background="@drawable/input"
                android:padding="12dp" />

            <Button
                android:id="@+id/rcdCurrentSaveBtn"
                android:text="✔"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_gravity="center_horizontal"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="Zapisz prąd RCD" />
        </LinearLayout>

        <Space
            android:layout_width="48dp"
            android:layout_height="match_parent"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/photoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/measurementPhoto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true" />

        <Button
            android:id="@+id/deletePhotoBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuń zdjęcie"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>