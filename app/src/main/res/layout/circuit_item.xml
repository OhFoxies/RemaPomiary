<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/white"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="1."
        android:textSize="16sp" />
    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="2"
        android:gravity="center"
        android:visibility="gone"
        android:textStyle="bold"
        android:text="Brak dostępu"
        android:textSize="16sp" />
    <Spinner
        android:id="@+id/circuitNameSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginEnd="10dp"
        android:layout_weight="2"


        android:textSize="16sp" />


    <EditText
        android:id="@+id/circuitInputName"
        style="@style/TextAppearance.Material3.SearchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:imeOptions="actionDone"
        android:layout_weight="3"
        android:ems="10"
        android:focusable="true"
        android:focusableInTouchMode="true"

        android:inputType="text"
        android:text="Test"
        android:textSize="16sp" />

    <Button
        android:id="@+id/circuitNameSave"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        android:layout_marginEnd="10dp"
        android:text="✔" />

    <RadioGroup
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:id="@+id/phasesGroup"
        android:layout_weight="1.5"
        android:gravity="center"

        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio1f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:text="1f"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/radio3f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:text="3f"

            android:textSize="16sp" />
    </RadioGroup>

    <Button
        android:id="@+id/deleteCiruit"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_weight="1.5"

        android:backgroundTint="#f23022"
        android:text="🗑️  Usuń"
        android:textSize="16sp" />


</LinearLayout>